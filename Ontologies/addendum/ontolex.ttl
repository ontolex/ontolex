# Triples that are added to the ontolex ontology when it is generated from the
# specification, but are not stated in it (see README.md, "Extracting the Ontology").

@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix vs: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .

vs:term_status a owl:AnnotationProperty .

ontolex:Affix vs:term_status "stable" .

ontolex:ConceptSet vs:term_status "stable" .

ontolex:Form vs:term_status "stable" .

ontolex:LexicalConcept vs:term_status "stable" .

ontolex:LexicalEntry vs:term_status "stable" .

ontolex:LexicalSense vs:term_status "stable" .

ontolex:MultiWordExpression vs:term_status "stable" .

ontolex:Word vs:term_status "stable" .

ontolex:canonicalForm vs:term_status "stable" .

ontolex:concept vs:term_status "stable" .

ontolex:denotes vs:term_status "stable" .

ontolex:evokes vs:term_status "stable" .

ontolex:isConceptOf vs:term_status "stable" .

ontolex:isDenotedBy vs:term_status "stable" .

ontolex:isEvokedBy vs:term_status "stable" .

ontolex:isLexicalizedSenseOf vs:term_status "stable" .

ontolex:isReferenceOf vs:term_status "stable" .

ontolex:isSenseOf vs:term_status "stable" .

ontolex:lexicalForm vs:term_status "stable" .

ontolex:lexicalizedSense vs:term_status "stable" .

ontolex:morphologicalPattern vs:term_status "stable" .

ontolex:otherForm vs:term_status "stable" .

ontolex:phoneticRep vs:term_status "stable" .

ontolex:reference vs:term_status "stable" .

ontolex:representation vs:term_status "stable" .

ontolex:sense vs:term_status "stable" .

ontolex:usage vs:term_status "stable" .

ontolex:writtenRep vs:term_status "stable" .

