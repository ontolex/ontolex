# Triples that are added to the lime ontology when it is generated from the
# specification, but are not stated in it (see README.md, "Extracting the Ontology").

@prefix lime: <http://www.w3.org/ns/lemon/lime#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix vs: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .

vs:term_status a owl:AnnotationProperty .

lime:ConceptualizationSet vs:term_status "stable" .

lime:LexicalLinkset vs:term_status "stable" .

lime:LexicalizationSet vs:term_status "stable" .

lime:Lexicon vs:term_status "stable" .

lime:avgAmbiguity vs:term_status "stable" .

lime:avgNumOfLexicalizations vs:term_status "stable" .

lime:avgNumOfLinks vs:term_status "stable" .

lime:avgSynonymy vs:term_status "stable" .

lime:concepts vs:term_status "stable" .

lime:conceptualDataset vs:term_status "stable" .

lime:conceptualizations vs:term_status "stable" .

lime:entry vs:term_status "stable" .

lime:language vs:term_status "stable" .

lime:lexicalEntries vs:term_status "stable" .

lime:lexicalizationModel vs:term_status "stable" .

lime:lexicalizations vs:term_status "stable" .

lime:lexiconDataset vs:term_status "stable" .

lime:linguisticCatalog vs:term_status "stable" .

lime:links vs:term_status "stable" .

lime:partition vs:term_status "stable" .

lime:percentage vs:term_status "stable" .

lime:referenceDataset vs:term_status "stable" .

lime:references vs:term_status "stable" .

lime:resourceType vs:term_status "stable" .

