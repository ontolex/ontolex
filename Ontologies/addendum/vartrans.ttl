# Triples that are added to the vartrans ontology when it is generated from the
# specification, but are not stated in it (see README.md, "Extracting the Ontology").

@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix vartrans: <http://www.w3.org/ns/lemon/vartrans#> .
@prefix vs: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .

vs:term_status a owl:AnnotationProperty .

vartrans:LexicalRelation vs:term_status "stable" .

vartrans:LexicoSemanticRelation vs:term_status "stable" .

vartrans:SenseRelation vs:term_status "stable" .

vartrans:TerminologicalRelation vs:term_status "stable" .

vartrans:Translation vs:term_status "stable" .

vartrans:TranslationSet vs:term_status "stable" .

vartrans:category vs:term_status "stable" .

vartrans:lexicalRel vs:term_status "stable" .

vartrans:relates vs:term_status "stable" .

vartrans:senseRel vs:term_status "stable" .

vartrans:source vs:term_status "stable" .

vartrans:target vs:term_status "stable" .

vartrans:trans vs:term_status "stable" .

vartrans:translatableAs vs:term_status "stable" .

vartrans:translation vs:term_status "stable" .

