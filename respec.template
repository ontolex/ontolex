<!DOCTYPE html>
<html
  prefix="
    rdf: http://www.w3.org/1999/02/22-rdf-syntax-ns#
    rdfs: http://www.w3.org/2000/01/rdf-schema#
    owl: http://www.w3.org/2002/07/owl#
    xsd: http://www.w3.org/2001/XMLSchema#
    ontolex: http://www.w3.org/ns/lemon/ontolex#
    synsem: http://www.w3.org/ns/lemon/synsem#
    decomp: http://www.w3.org/ns/lemon/decomp#
    vartrans: http://www.w3.org/ns/lemon/vartrans#
    lime: http://www.w3.org/ns/lemon/lime#
    lexicog: http://www.w3.org/ns/lemon/lexicog#
    lexinfo: http://www.lexinfo.net/ontology/2.0/lexinfo#">
  <head>
    <meta charset="utf-8" />
    <title>$title$</title>
    <script
      src="https://www.w3.org/Tools/respec/respec-w3c"
      class="remove"
      defer
    ></script>
    <script class="remove">
      // All config options at https://respec.org/docs/
      var respecConfig = {
        specStatus: "CG-DRAFT",
        editors: [
$for(editor)$
    {
"name": 
"$editor.name$", 
"company": 
"$editor.company$", 
"companyURL": 
"$editor.companyURL$"},
$endfor$
        ],
        authors: [
$for(author)$
    {
"name": 
"$author.name$", 
"company": 
"$author.company$", 
"companyURL": 
"$author.companyURL$"},
$endfor$
        ],
        github: "ontolex/frequency-attestation-corpus-information",
        shortName: "FrAC",
        group: "ontolex",
        latestVersion: "https://ontolex.github.io/frequency-attestation-corpus-information/"
      };
    </script>
    <script type="module">
      import mermaid from "https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs";
      const dark = window.matchMedia("(prefers-color-scheme: dark)");
      // Keep each diagram's plain-text source before anything rewrites it:
      // ReSpec wraps pre contents in a highlighted code element, and rendering
      // replaces them with an SVG, so the text is needed to re-render.
      const blocks = document.querySelectorAll("pre.mermaid");
      blocks.forEach(el => { el.dataset.source = el.textContent; });
      // ReSpec rewrites the DOM; render diagrams only once it has finished.
      async function render() {
        mermaid.initialize({ startOnLoad: false, theme: dark.matches ? "dark" : "default" });
        blocks.forEach(el => {
          el.removeAttribute("data-processed");
          el.textContent = el.dataset.source;
        });
        await mermaid.run({ nodes: blocks });
      }
      document.respec.ready.then(render);
      dark.addEventListener("change", render);
    </script>
    <style>
.entity {
     border: 1px solid #000080;
     width: 80%;
     margin-left: auto;
     margin-right: auto;
     padding: 10px;
     margin-bottom: 10px;
 }
.entity > p:first-child {
     margin-top: 3px;
     padding-bottom: 5px;
     border-bottom: 1px solid #000080;
     font-size: 120%;
     color: var(--heading-text);
     page-break-after: avoid;
     page-break-inside: avoid;
     line-height: 1.2;        /* Keep wrapped headings compact */
     hyphens: manual;         /* Hyphenated headings look weird */
}
.description {
     border-top: 1px dashed #808080;
     margin-top: 5px;
     padding-bottom: 5px;
}
.example img {
    max-width: 100%;
}

pre.mermaid {
    background: none;
    border: none;
    text-align: center;
}
pre.mermaid svg {
    max-width: 100%;
    height: auto;
}


 </style>
  </head>
  <body lang="en">
  $body$
  </body>
</html>
